<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal hardened-runtime entitlements for the OpenCluely main bundle.

  Included, and why:
    allow-jit                        V8 needs a writable+executable JIT region.
    allow-unsigned-executable-memory Chromium/V8 fall back to this on some
                                     code paths; without it the renderer
                                     crashes immediately under hardened runtime.
    allow-dyld-environment-variables Electron sets DYLD_* for its helpers.
    disable-library-validation       Required so the signed app can load the
                                     Electron framework and any native module
                                     signed with a different identity.
    device.audio-input               Microphone capture for speech-to-text.

  Deliberately NOT included:
    The debugger-attach entitlement. It makes the build attachable by a
    debugger and is invalid for distribution, so it must never appear below.
    (Its exact key is asserted absent by test/app-identity.test.js.)
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
